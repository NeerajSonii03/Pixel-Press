{
  "manifest_version": 3,
  "name": "Pixel Press \u2014 Images to PDF",
  "version": "1.4.6",
  "description": "Capture full-resolution images from any page (including gallery sites) and export a lossless, original-size PDF.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pixel Press"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
